# LiveKit project — same values as the Laravel side
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Must match LIVEKIT_AGENT_NAME in Laravel's .env, or dispatches never arrive.
LIVEKIT_AGENT_NAME=screening-agent

# Where the result goes. The secret must equal SCREENING_WEBHOOK_SECRET in
# Laravel — the webhook is refused outright without it.
SCREENING_WEBHOOK_URL=https://superkarigar.com/api/v1/webhooks/screening-call
SCREENING_WEBHOOK_SECRET=

# Models. "provider/model" strings run on LiveKit Inference, so no separate
# accounts or API keys are needed. Change TTS here if the Hindi listening test
# favours a different voice.
SCREENING_STT=deepgram/nova-3
SCREENING_TTS=cartesia/sonic-3
SCREENING_LLM=openai/gpt-4o-mini

# Set to "plugins" to call each vendor directly with our own key instead of
# going through LiveKit Inference. Required when LiveKit is self-hosted, and
# also the only way to reach a vendor Inference does not carry (Sarvam, Inworld).
# SCREENING_SPEECH=plugins

# One voice for every call, so workers start recognising it. The id is
# provider-specific and a name from the wrong vendor synthesises *silence*
# rather than erroring — only set an id you have actually heard speak.
#   sarvam    speakers, e.g. "anushka"
#   inworld   built-ins e.g. "Meher", or a cloned "<workspace>__<name>"
# SCREENING_VOICE=

# Vendor keys, used only when SCREENING_SPEECH=plugins.
# SARVAM_API_KEY=
# CARTESIA_API_KEY=
# Inworld is the one whose free tier will clone a voice (70 min TTS free).
# INWORLD_API_KEY=

# Seconds to let the phone ring before giving up. Laravel schedules the retry.
SCREENING_ANSWER_TIMEOUT=45

# Hard cap on a call once it is answered. The agent normally hangs up itself via
# the end_call tool; this is the backstop for when it does not. Kept above the
# two minutes the script aims for, so a slightly long call finishes properly
# rather than being cut mid-sentence.
SCREENING_MAX_CALL_SECONDS=180
